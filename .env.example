# Telegram (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id of the allowlisted account (message @userinfobot)
TELEGRAM_USER_ID=

# Groq (console.groq.com → API Keys)
GROQ_API_KEY=

# Ingest chat model (Groq)
MODEL_INGEST=openai/gpt-oss-120b

# Postgres. Prefer the Supabase session pooler (port 5432) with the SQLAlchemy driver.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./data/readurlist.db

# Daily ranked digest on the worker host's local clock (24h)
DIGEST_HOUR=8

# Public website origin for Telegram links (no trailing slash)
SITE_URL=https://your-app.vercel.app
