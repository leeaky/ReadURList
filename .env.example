# Telegram (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (message @userinfobot)
TELEGRAM_USER_ID=

# Groq (console.groq.com → API Keys)
GROQ_API_KEY=

# Per-task chat models (Groq). Embeddings are local (sentence-transformers).
MODEL_INGEST=llama-3.3-70b-versatile
MODEL_CONNECT=llama-3.3-70b-versatile
MODEL_PING=llama-3.3-70b-versatile
MODEL_CONVERSE=llama-3.3-70b-versatile
MODEL_EMBED=all-MiniLM-L6-v2

# Local SQLite path
DATABASE_URL=sqlite:///./data/second_read.db

# Quiet hours (local machine timezone), 24h clock
QUIET_HOURS_START=9
QUIET_HOURS_END=21

# Ping caps
MAX_PINGS_PER_DAY=2
PING_CHECK_INTERVAL_MINUTES=45
