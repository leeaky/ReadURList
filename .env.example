# Telegram (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (message @userinfobot)
TELEGRAM_USER_ID=

# Groq (console.groq.com → API Keys)
GROQ_API_KEY=

# Ingest chat model (Groq)
MODEL_INGEST=openai/gpt-oss-120b

# Postgres (ReadURList Supabase, ap-southeast-2). Use the session pooler — the
# db.PROJECT.supabase.co host has no public A record on this project.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./data/second_read.db

# Daily ranked digest on the NUC's local clock (24h)
DIGEST_HOUR=8

# Public website origin for Telegram links (no trailing slash)
SITE_URL=https://your-app.vercel.app
